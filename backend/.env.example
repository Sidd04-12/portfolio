# Neon connection string (https://neon.tech — free tier, no card)
DATABASE_URL=postgresql://user:password@host.neon.tech/portfolio?sslmode=require

# Must be at least 32 characters. Rotating this invalidates all admin sessions.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Salts the visitor hash so it can't be recomputed from public information.
VISITOR_HASH_SECRET=change-me-too-16-chars-min

# Comma-separated frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173

# Optional: raises the GitHub API rate limit from 60/hr to 5000/hr.
GITHUB_TOKEN=
GITHUB_USER=Sidd04-12

PORT=4000
NODE_ENV=development

# Only read by `npm run db:seed`, never by the server.
ADMIN_EMAIL=
ADMIN_PASSWORD=
