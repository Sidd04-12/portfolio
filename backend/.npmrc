# Render sets NODE_ENV=production, and npm honours that at install time by omitting
# devDependencies. That breaks the build, because TypeScript and the @types packages it needs
# to compile (@types/node, @types/bcryptjs, @types/node-cron) are dev dependencies — tsc ends up
# not knowing what `process` or `console` are.
#
# `include` beats `omit` regardless of ordering or NODE_ENV, so this restores them for the build
# without having to move build-time tooling into runtime dependencies.
include=dev
